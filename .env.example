# Copy to .env and edit. Never commit .env.

# Local pgvector from docker-compose (port 5433 so it does not clash with a local Postgres).
# For Supabase: use the connection string from Project Settings > Database, and enable the "vector" extension.
DATABASE_URL=postgresql://labellens:labellens@localhost:5433/labellens

# ---- Model. Default: a local Ollama model (free, no account, label text never leaves the machine). ----
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Option B: OpenAI (or any OpenAI-compatible endpoint: vLLM, Groq, Together, ...)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<model name>

# Option C: Claude via the official Anthropic SDK (uv sync --extra anthropic)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5          # or claude-sonnet-5-5 / claude-haiku-5-5 for lower cost

# Retrieval mode: hybrid (dense + full-text, default) or vector (dense only).
RETRIEVAL=hybrid

# Optional. Raises the openFDA rate limit. Free at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
